      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Time since last ingestion run",
          "description": "Minutes since the last completed run seen in Prometheus, including failed runs.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "PBFA97CFB590B2093"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(time() - (max_over_time(content_ingestion_last_completion_timestamp_seconds[15d]) > 0)) / 60",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
