FROM python:3.14-slim

WORKDIR /app/srcs/services/content-management

COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /uvx /usr/local/bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv

COPY ./pyproject.toml ./
COPY ./uv.lock ./

COPY --from=shared_errors / /app/shared/packages/shared_errors/
COPY --from=shared_auth / /app/shared/packages/shared_auth/

RUN uv sync --frozen --no-install-project

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# --reload-dir replaces uvicorn's default (the current folder), so both folders
# are listed: the service and the shared packages mounted by compose.override.yaml.
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", \
    "--reload-dir", "/app/srcs/services/content-management", \
    "--reload-dir", "/app/shared/packages"]
