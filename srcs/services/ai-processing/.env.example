# ============================================================
# srcs/services/ai_processing/.env
# ------------------------------------------------------------
# Service-specific configuration, read directly by this service's
# Settings class (env_file=BASE_DIR / ".env").
#
# Anything shared with other services (POSTGRES_HOST/USER/PASSWORD/PORT)
# is deliberately absent here — it arrives as a real environment
# variable, and pydantic-settings prefers that over this file.
# ============================================================
PROJECT_NAME=ai_processing
POSTGRES_DB_NAME=ai_processing_db
POSTGRES_ENABLE_VECTOR_EXTENSION=true

# Origins allowed to call this API from another origin (CORS).
# Empty: the browser calls the API on the page's own origin, through the gateway
# (https://localhost:8443) or Vite's proxy (make frontend), so no CORS is needed.
BACKEND_CORS_ORIGINS=[]
