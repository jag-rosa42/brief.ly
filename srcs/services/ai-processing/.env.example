# ============================================================
# srcs/services/ai_processing/.env
# ------------------------------------------------------------
# Service-specific configuration, read directly by this service's
# Settings class (env_file=BASE_DIR / ".env").
#
# Anything shared with other services (POSTGRES_HOST/USER/PASSWORD/PORT)
# is deliberately absent here — it arrives as a real environment
# variable, and pydantic-settings prefers that over this file.
# ============================================================
PROJECT_NAME=ai_processing
POSTGRES_DB_NAME=ai_processing_db
POSTGRES_ENABLE_VECTOR_EXTENSION=true

# Origins allowed to call this API from another origin (CORS).
# Empty: the browser calls the API on the page's own origin, through the gateway
# (https://localhost:8443) or Vite's proxy (make frontend), so no CORS is needed.
BACKEND_CORS_ORIGINS=[]

# Article summary worker in this repository's QEMU VM.
# Content Management defaults to http://content-management:8000 in Compose.
# For a worker running on the host, set CONTENT_MANAGEMENT_BASE_URL=http://localhost:8083.
# QEMU user networking exposes the host to the guest at 10.0.2.2.
# For a worker running on the host, use http://localhost:11434 instead.
OLLAMA_BASE_URL=http://10.0.2.2:11434
# Used by the worker, make ollama, and manual Ollama workflow tests.
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_LENGTH=8192
ARTICLE_BATCH_SIZE=25

# Base URL of Identity, which gives the service token for Content Management
# Local (worker on the host): http://localhost:8081
# Containers:                 http://identity:8000 (set by compose.yaml)
IDENTITY_URL=http://localhost:8081

# ------------------------------------------------------------
# The digest and its chat (ADR-0011): routes the browser calls
# ------------------------------------------------------------
# Base URL of Personalization (the reader's topics)
# Local (make run): http://localhost:8082
# Containers:       http://personalization:8000 (set by compose.yaml)
PERSONALIZATION_URL=http://localhost:8082

# Audience of this service in service tokens (shared_auth). Required by
# shared_auth even though nobody sends this service a service token.
# Containers: set by compose.yaml
JWT_SERVICE_AUDIENCE=transcendence:ai-processing
