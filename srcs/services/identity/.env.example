# ============================================================
# srcs/services/identity/.env
# ------------------------------------------------------------
# Service-specific configuration, read directly by this service's
# Settings class (env_file=BASE_DIR / ".env").
#
# Anything shared with other services (POSTGRES_HOST/USER/PASSWORD/PORT)
# is deliberately absent here — it arrives as a real environment
# variable, and pydantic-settings prefers that over this file.
# ============================================================
PROJECT_NAME=identity
POSTGRES_DB_NAME=identity_db

# List of allow origins to connect with this API
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# JWT
# The keys come from shared/secrets (or /run/secrets in a container), never
# from this file.
# The algorithm is always RS256 (not configurable anymore).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7