# ============================================================
# srcs/services/identity/.env
# ------------------------------------------------------------
# Service-specific configuration, read directly by this service's
# Settings class (env_file=BASE_DIR / ".env").
#
# Anything shared with other services (POSTGRES_HOST/USER/PASSWORD/PORT)
# is deliberately absent here — it arrives as a real environment
# variable, and pydantic-settings prefers that over this file.
# ============================================================
PROJECT_NAME=identity
POSTGRES_DB_NAME=identity_db

# Origins allowed to call this API from another origin (CORS).
# Empty: the browser calls the API on the page's own origin, through the gateway
# (https://localhost:8443) or Vite's proxy (make frontend), so no CORS is needed.
BACKEND_CORS_ORIGINS=[]

# JWT
# The keys come from shared/secrets (or /run/secrets in a container), never
# from this file.
# The algorithm is always RS256 (not configurable anymore).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Service tokens (POST /internal/v1/oauth/token, ADR-0008)
SERVICE_TOKEN_EXPIRE_MINUTES=5
# Public API tokens (/internal/v1/api-keys/verify, ADR-0009): one request each
PUBLIC_API_TOKEN_EXPIRE_SECONDS=60

# Optional overrides (defaults shown, see src/infrastructure/security/settings.py)
# JWT_ISSUER=transcendence:identity
# JWT_ACCESS_AUDIENCE=transcendence:api
# JWT_REFRESH_AUDIENCE=transcendence:identity
# JWT_PUBLIC_API_AUDIENCE=transcendence:public-api

# Refresh cookie
# Optional overrides (defaults shown, see src/infrastructure/config/cookie.py)
# The path is the one the BROWSER sees (before the gateway strips /api/identity).
# REFRESH_COOKIE_NAME=refresh_token
# REFRESH_COOKIE_PATH=/api/identity/auth