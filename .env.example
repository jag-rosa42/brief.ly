# ============================================================
# transcendence/.env
# ------------------------------------------------------------
# Shared configuration. Consumed by:
#   - transcendence/Makefile and shared/mk/service.mk (via `include` + `export`)
#   - docker-compose.yml (Compose auto-loads a .env next to it)
#
# NOT read directly by any service's Settings class. Services only
# ever see these as real process environment variables, handed down
# by Make (local dev) or docker-compose (containers).
# ============================================================

# ---- For VM env vars ----

# Keep VM disks and host backups under one configurable host directory.
PROJECT_STORAGE_DIR=$(CURDIR)
VM_DIR=$(PROJECT_STORAGE_DIR)/vm
SSH_PUBLIC_KEY=$(HOME)/.ssh/id_rsa.pub
VM_SSH_PORT=2222

# Host-side backup repository, beside the VM directory.
BACKUP_HOST_DIR=$(PROJECT_STORAGE_DIR)/backups
# Host-only backup encryption password; vm-sync excludes this file.
BACKUP_PASSWORD_FILE=$(CURDIR)/shared/secrets/backup_password

# ---- For container env vars----
DOMAIN=transcendence
# Adminer, the database web page (development only). Like the databases, it
# is reachable from this computer only: http://localhost:8086
ADMINER_PORT=8086
# Grafana is reachable on host loopback when the VM runs; QEMU forwards this port.
GRAFANA_PORT=3000
# Grafana creates this admin account on first start. Its password is generated
# separately in the ignored shared/secrets/grafana_admin_password file.
GRAFANA_ADMIN_USER=admin
#default dabatase path inside the container to mount for postgre
PGDATA=/var/lib/postgresql/data

# ---- Gateway (the public application ports) ----
# The app is served at https://localhost:8443; http://localhost:8080
# redirects there. Keep 8443: Traefik's redirect uses that port number.
GATEWAY_PORT=8080
GATEWAY_HTTPS_PORT=8443

# ---- Host ports for processes run outside containers ----
# `make run SERVICE=<name>` and `make frontend` listen on these. Containers
# never publish them: in Docker, everything goes through the gateway.
IDENTITY_PORT=8081
PERSONALIZATION_PORT=8082
CONTENT_MANAGEMENT_PORT=8083
AI_PROCESSING_PORT=8084
MORNING_BRIEFING_PORT=8085
FRONTEND_PORT=5173

# ---- Shared Postgres connection info ----
# POSTGRES_HOST=localhost is correct for local `make run`.
# docker-compose.yml overrides this to "postgres" (the compose
# service name) for anything running inside a container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=transcendence
POSTGRES_DEFAULT_DB_NAME=postgres

# ---- ai-processing's dedicated pgvector instance (separate server) ----
AI_POSTGRES_PORT=5433

# ---- Service URLs inside the Docker network ----
CONTENT_MANAGEMENT_INTERNAL_URL=http://content-management:8000
PERSONALIZATION_INTERNAL_URL=http://personalization:8000
IDENTITY_INTERNAL_URL=http://identity:8000

